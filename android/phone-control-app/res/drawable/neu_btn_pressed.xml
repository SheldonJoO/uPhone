<?xml version="1.0" encoding="utf-8"?>
<!-- Neumorphism 凹陷按钮（按压态）：阴影反转，呈现被按下去的效果 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_dark" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_light" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_bg" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
