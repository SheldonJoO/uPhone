<?xml version="1.0" encoding="utf-8"?>
<!-- Neumorphism 主按钮·绿：彩色填充 + 双阴影，按压时加深并凹陷 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:right="5dp" android:bottom="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/neu_shadow_dark" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item android:left="5dp" android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/neu_shadow_light" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/neu_accent_green_pressed" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="5dp" android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/neu_shadow_dark" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item android:right="5dp" android:bottom="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/neu_shadow_light" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/neu_accent_green" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
